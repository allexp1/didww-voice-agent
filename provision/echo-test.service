[Unit]
Description=didww-voice-agent — SIP echo test (RTP reflector / trunk smoke test)
After=network.target docker.service
Requires=docker.service
# Only one app may own the drachtio INVITE stream — starting the echo test
# stops the agent, and vice versa.
Conflicts=voice-ai-agent.service

[Service]
Type=simple
WorkingDirectory=/opt/voice-ai
EnvironmentFile=/opt/voice-ai/.env
ExecStart=/usr/bin/node /opt/voice-ai/echo-test.js
Restart=on-failure
RestartSec=3
StandardOutput=append:/var/log/voice-ai/echo-test.log
StandardError=append:/var/log/voice-ai/echo-test.log

[Install]
WantedBy=multi-user.target
