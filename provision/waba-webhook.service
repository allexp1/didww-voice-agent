[Unit]
Description=WABA webhook for WhatsApp Business Calling
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/voice-ai
EnvironmentFile=/opt/voice-ai/.env
ExecStart=/usr/bin/node /opt/voice-ai/webhook.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=12
StandardOutput=append:/var/log/voice-ai/webhook.log
StandardError=append:/var/log/voice-ai/webhook.log

[Install]
WantedBy=multi-user.target
